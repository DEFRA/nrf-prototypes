{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-written-copy.sh",
            "timeout": 10,
            "statusMessage": "Checking for written-copy changes"
          }
        ]
      }
    ]
  }
}
